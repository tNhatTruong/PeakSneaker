{
  "name": "peaksneaker-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "start": "pnpm dev",
    "dev": "pnpm db && concurrently -k -c \"cyan,magenta\" -n \"BACKEND,FRONTEND\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "db": "docker compose -f infra/docker-compose.yml up -d",
    "db:stop": "docker compose -f infra/docker-compose.yml down",
    "dev:backend": "cd backend && gradlew bootRun",
    "dev:frontend": "pnpm --dir frontend dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
